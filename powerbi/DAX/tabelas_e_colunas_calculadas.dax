// =====================================================================
// tabelas_e_colunas_calculadas.dax
// Criar ANTES das medidas. Em Desktop: Modelagem > Nova tabela / Nova coluna.
// =====================================================================

// ---------------------------------------------------------------------
// TABELAS CALCULADAS
// ---------------------------------------------------------------------

// Tabela-casa das medidas. Ocultar a coluna [Value] depois de criar as medidas.
_Medidas = { BLANK () }

// Seletor da definicao de taxa (tabela DESCONECTADA: sem relacionamento).
dSeletorTaxa =
DATATABLE (
    "Definicao", STRING,
    "Ordem", INTEGER,
    {
        { "Cumulativa", 1 },
        { "Condicional", 2 }
    }
)

// Parametro what-if do custo. PREMISSA ILUSTRATIVA: o dataset nao contem
// custo real. Tabela desconectada; segmentador de selecao unica.
dParametroCusto =
SELECTCOLUMNS ( GENERATESERIES ( 0, 500, 10 ), "R$ por dia-camara", [Value] )

// ---------------------------------------------------------------------
// COLUNAS CALCULADAS (em dLote)
// ---------------------------------------------------------------------

// ORDEM: a primeira coluna usa a medida [Medições OOS]. Crie essa medida ANTES
// (Nova medida na tabela _Medidas). A etapa das medidas (medidas.dax) a redefine
// com o mesmo conteudo.
//
// Medições OOS = CALCULATE ( COUNTROWS ( fMedicoes ), fMedicoes[oos] = TRUE () )


// Transicao de contexto: a medida [Medições OOS], avaliada numa coluna
// calculada, herda o contexto de LINHA de dLote e passa a contar so as
// medicoes daquele lote. Sem o CALCULATE implicito, retornaria o total.
dLote[Medicoes OOS do lote] = [Medições OOS]

dLote[Situacao de OOS] =
IF ( dLote[Medicoes OOS do lote] > 0, "Com OOS", "Sem OOS" )

// Eixo de tempo para analise de CAUSAS (a ponte nao responde ao calendario).
dLote[AnoMesInicio] = FORMAT ( dLote[data_inicio_teste], "YYYY-MM" )

// ---------------------------------------------------------------------
// ORDENACAO POR COLUNA (Ferramentas de coluna > Classificar por coluna)
// ---------------------------------------------------------------------
//   dLote[estagio_final]    por dLote[estagio_final_ordem]
//   dCondicao[condicao]     por dCondicao[ordem]
//   dEnsaio[ensaio]         por dEnsaio[ordem]
//   dCausa[causa]           por dCausa[ordem]
//   dCalendario[Mes]        por dCalendario[MesNum]
//   dCalendario[DiaSemana]  por dCalendario[DiaSemanaNum]
//   dSeletorTaxa[Definicao] por dSeletorTaxa[Ordem]
